//@version=6
// SuperTrend long-only trend follower (MNQ / MGC). Fires TradersPost-format
// webhook alerts. Signal logic is the user's "SuperTrend STRATEGY" (Slow Cow)
// unchanged: ATR = SMA of true range, bands around hl2, trend flips when the
// close crosses the previous bar's band.
//
// Rules:
//   1. Trend flips up   -> buy (market).
//   2. Trend flips down -> exit. There are no shorts: shorting the same flips
//      lost money on ES and cut the NQ result by more than half (see below).
//   3. Optional broker-side safety stop, sent with the entry at the band
//      level on the entry bar. The band only ratchets up after that, so the
//      normal close-based exit almost always comes first; the stop is there
//      for gaps, outages or a stalled webhook.
//   4. Optional flat-by-close mode (off by default, see "Flat by close"):
//      exit at `flattenTime` (16:00 ET), no entries until `resumeTime`
//      (18:00 ET, the CME reopen), then re-enter if the trend is still up.
//      18:00 -> 16:00 next day is one CME trading day, so this never holds
//      through a daily close or a weekend. If a safety stop fills, it waits
//      for the next flip up instead of re-entering.
//
// Differences from the original script (all on purpose, for live use):
//   - Fixed contract size instead of 100% of equity, so the tester shows $
//     per contract, which is what matters against a prop-firm drawdown limit.
//   - Costs are $1/contract/side + 1 tick slippage instead of 0.015% of
//     notional.
//   - Fills on the next bar's open (process_orders_on_close=false): the
//     webhook can only fire after the signal bar has closed.
//
// Evidence: a Python replica of these rules on 15m bars (1 contract, same
// costs as above, 2020-01 to 2026-08; backtest/supertrend_sweep.py and
// backtest/supertrend_flat_by_close.py), which aren't the 8m/10m bars of
// the original screenshots:
//                         hold overnight           flat by close (16:00/18:00)
//   NQ -> MNQ  x8.5   +$25.2k  DD $8.1k  PF 1.25   +$17.2k  DD $8.2k  PF 1.11
//   GC -> MGC  x8.5   +$25.1k  DD $5.6k  PF 1.46   +$17.5k  DD $6.7k  PF 1.17
//   GC -> MGC  x7     +$31.6k  DD $5.4k  PF 1.50   +$22.0k  DD $7.1k  PF 1.21
//   Every multiplier from 3 to 12 was profitable held overnight on both, so
//   8.5 isn't a lucky pick. BUT buy-and-hold made more over the same period
//   (MNQ +$41k, MGC +$31k), with bigger drawdowns ($12.5k / $16.5k). This is
//   a trend filter that trades return for smaller drawdowns in a bull
//   market. It isn't an edge that works regardless of market direction.
//   Gold 2016-2019 was slightly negative.
//   Flat by close keeps about 2/3 of the profit but does NOT reduce the
//   drawdown, and it roughly doubles the trade count. Re-entering at 09:30
//   instead of 18:00, or waiting for a fresh flip, made about $0 or lost
//   money. On ES it was break-even to negative in every variant.
//
// A single contract's drawdown ($5-8k) is several times a typical $50k prop
// account's trailing drawdown limit, with or without flat by close.
//
// Alerting: TradingView alert with condition "Any alert() function call",
// webhook URL = your TradersPost strategy's webhook URL. See
// ../TRADINGVIEW_WEBHOOK.md.

strategy("SuperTrend Long (TradersPost)", shorttitle="ST Long", overlay=true,
     pyramiding=0, initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=1.0,
     slippage=1, calc_on_every_tick=false, process_orders_on_close=false)

// ---- Inputs ----
Periods    = input.int(10, "ATR Period", minval=1)
src        = input(hl2, "Source")
Multiplier = input.float(8.5, "ATR Multiplier", step=0.1, minval=0.1)
qty        = input.int(1, "Contracts", minval=1)
useStop    = input.bool(true, "Send broker-side safety stop at the entry band")

flatByClose = input.bool(false, "Flat by close", group="Flat by close")
flattenHHMM = input.int(1600, "Flatten time HHMM (America/New_York)", minval=0, maxval=2359, group="Flat by close",
     tooltip="Set this to your prop firm's cutoff or a few minutes before it, e.g. 1605 for a 16:10 ET rule. Use a chart timeframe with a bar that closes exactly at this time.")
resumeHHMM  = input.int(1800, "Resume time HHMM (America/New_York)", minval=0, maxval=2359, group="Flat by close",
     tooltip="No entries from the flatten time until this time. 1800 = CME reopen.")
reEnter     = input.bool(true, "Re-enter at resume time if trend is still up", group="Flat by close",
     tooltip="Off = after a flatten, wait for the next fresh flip up (much worse in testing).")

FromMonth = input.int(1,    "From Month", minval=1, maxval=12, group="Date window")
FromDay   = input.int(1,    "From Day",   minval=1, maxval=31, group="Date window")
FromYear  = input.int(2020, "From Year",  minval=999, group="Date window")
ToMonth   = input.int(1,    "To Month",   minval=1, maxval=12, group="Date window")
ToDay     = input.int(1,    "To Day",     minval=1, maxval=31, group="Date window")
ToYear    = input.int(9999, "To Year",    minval=999, group="Date window")

// ---- SuperTrend (identical to the original) ----
atrVal = ta.sma(ta.tr, Periods)
up  = src - (Multiplier * atrVal)
up1 = nz(up[1], up)
up := close[1] > up1 ? math.max(up, up1) : up
dn  = src + (Multiplier * atrVal)
dn1 = nz(dn[1], dn)
dn := close[1] < dn1 ? math.min(dn, dn1) : dn

trend = 1
trend := nz(trend[1], trend)
trend := trend == -1 and close > dn1 ? 1 : trend == 1 and close < up1 ? -1 : trend

buySignal  = trend == 1 and trend[1] == -1
sellSignal = trend == -1 and trend[1] == 1

start  = timestamp(FromYear, FromMonth, FromDay, 00, 00)
finish = timestamp(ToYear, ToMonth, ToDay, 23, 59)
inWindow = time >= start and time <= finish

// ---- Flat-by-close timing (explicit New York time) ----
TZ = "America/New_York"
fH = math.floor(flattenHHMM / 100)
fM = flattenHHMM % 100
flattenHm  = fH * 60 + fM
resumeHm   = math.floor(resumeHHMM / 100) * 60 + resumeHHMM % 100
barCloseHm = hour(time_close, TZ) * 60 + minute(time_close, TZ)
// No entries while the bar closes inside [flatten, resume), wrapping midnight.
inBlackout = flattenHm < resumeHm ? (barCloseHm >= flattenHm and barCloseHm < resumeHm) :
                                    (barCloseHm >= flattenHm or barCloseHm < resumeHm)
entryAllowed = inWindow and not (flatByClose and inBlackout)

// First flatten time at or after a bar's close. Used as the deadline for a
// position, so an early-close holiday (no 16:00 bar) still gets flattened on
// the first bar after the deadline instead of being held overnight.
nextFlatten(t) =>
    f = timestamp(TZ, year(t, TZ), month(t, TZ), dayofmonth(t, TZ), fH, fM)
    t2 = t + 86400000   // rebuild tomorrow's date so a DST change can't shift the hour
    f < t ? timestamp(TZ, year(t2, TZ), month(t2, TZ), dayofmonth(t2, TZ), fH, fM) : f

// ---- Orders + TradersPost alerts ----
// Schema: https://docs.traderspost.io/docs/core-concepts/webhooks
var float safetyStop   = na
var bool  wantLong     = false   // an entry is due as soon as it's allowed
var int   flatDeadline = na

if buySignal
    wantLong := true
if sellSignal
    wantLong := false

flattenNow = flatByClose and strategy.position_size > 0 and not na(flatDeadline) and time_close >= flatDeadline
if flattenNow
    strategy.close_all(comment="eod flatten", immediately=true)
    alert('{"ticker":"' + syminfo.ticker + '","action":"exit"}', alert.freq_once_per_bar_close)
    // Pick back up at the resume time only if the trend is still up.
    wantLong := reEnter and trend == 1

exitNow = sellSignal and strategy.position_size > 0 and not flattenNow
if exitNow
    strategy.close("BUY", comment="trend flip")
    alert('{"ticker":"' + syminfo.ticker + '","action":"exit"}', alert.freq_once_per_bar_close)

goLong = wantLong and trend == 1 and entryAllowed and strategy.position_size == 0 and not flattenNow
if goLong
    wantLong     := false        // a stop-out waits for the next flip, not an instant re-entry
    safetyStop   := up
    flatDeadline := nextFlatten(time_close)
    strategy.entry("BUY", strategy.long, qty=qty)
    stopJson = useStop ? ',"stopLoss":{"type":"stop","stopPrice":' + str.tostring(safetyStop, format.mintick) + '}' : ''
    alert('{"ticker":"' + syminfo.ticker + '","action":"buy","orderType":"market","quantity":' + str.tostring(qty) +
         ',"signalPrice":' + str.tostring(close, format.mintick) + stopJson + '}', alert.freq_once_per_bar_close)

// Mirror the broker stop in the backtest so the tester matches live.
if useStop and (strategy.position_size > 0 or goLong)
    strategy.exit("Safety Stop", from_entry="BUY", stop=safetyStop)

// ---- Visuals ----
plot(trend == 1 ? up : na, "Up Trend",   style=plot.style_linebr, linewidth=2, color=color.green)
plot(trend == 1 ? na : dn, "Down Trend", style=plot.style_linebr, linewidth=2, color=color.red)
plot(strategy.position_size > 0 and useStop ? safetyStop : na, "Safety Stop", style=plot.style_linebr, color=color.new(color.gray, 30))
plotshape(buySignal  ? up : na, "Buy",   text="Buy",   location=location.absolute, style=shape.labelup,   size=size.tiny, color=color.green, textcolor=color.white)
plotshape(sellSignal ? dn : na, "Close", text="Close", location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.black, textcolor=color.white)
bgcolor(flatByClose and inBlackout ? color.new(color.gray, 90) : na, title="No-entry window")

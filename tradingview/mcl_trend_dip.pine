//@version=6
// MCL Trend Dip -- port of the trend_lab walk-forward winner (trend_lab/, see
// dashboard/index.html). Two "buy the dip inside a higher-timeframe trend"
// engines on one account, one position at a time (ATR-dip engine has priority
// when both fire on the same bar):
//
//   A) ATR dip   (python: trend_dip_atr, session "us") -- half off at +1R (scale-out), rest below
//      trend : close > 1h EMA50, 1h EMA50 rising over 12 chart bars, close > EMA100
//      dip   : some low in the last 6 bars <= EMA13 - 1.0*ATR14
//      entry : close > previous bar's high          (shorts: exact mirror)
//      stop  : lowest low of 8 bars - 0.1*ATR; target 2R; breakeven at +1R;
//              2.5*ATR chandelier trail. Entries 08:00-14:30 ET, flat 16:30 ET.
//
//   B) RSI dip   (python: trend_dip_rsi, session "ny")
//      trend : close > 4h EMA50, close > EMA100, EMA100 rising over 3 bars
//      dip   : RSI(3) crosses back up through 30 and close > previous high
//      stop  : lowest low of 5 bars - 0.1*ATR; target 3R; exit when RSI(3) > 70;
//              3.0*ATR chandelier trail. Entries 09:00-13:30 ET, flat 14:30 ET.
//
// Both: no entries Wed 10:15-10:45 ET (EIA), size = floor(risk / (stop*100 +
// $3.24 costs)) micros, daily loss stop = 2.25 x risk, stop entering after
// +$1,200 on the day (Lucid 50% consistency), max 6 trades/day.
// Risk per trade defaults to "Cushion" sizing: 25% of the distance between the
// account balance and Lucid's trailing max-loss line, clamped to $200-$600,
// with an equity-curve kill switch (live orders only while the strategy's
// equity is above its 20-trade average; shadow trades keep it updated)
// (set "Account start" to your eval's day 1). Fixed $300 is the alternative.
//
// REQUIRED CHART: MCL1! (or the front MCL contract), 15-minute, exchange time.
// (Untested-in-depth option: a 10-minute chart with A: slope 18, base EMA 150, fast EMA 20,
//  dip lookback 9, swing 12; B: base EMA 150, swing 8 kept PF ~1.6 May-Aug 2026 with ~40% more
//  trades. 5-minute does NOT work.)
// Settings came from an anchored walk-forward (re-optimized every 20 trading
// days, same parameters chosen in every window) on 11 months of 15m data,
// Oct 2025 - Aug 2026. Walk-forward OOS at $300 risk: see the dashboard.
// Past results on ~5 months of unseen data are NOT a guarantee. Forward-test
// on a sim/eval first.
//
// Alerts: every order carries its TradersPost JSON in alert_message. Create ONE
// alert on this strategy, condition "Order fills only", and set the alert's
// Message box to exactly:  {{strategy.order.alert_message}}
// Webhook URL = your TradersPost strategy webhook. See ../TRADINGVIEW_WEBHOOK.md.
// Entries send a market order with a broker-side protective stop (initial stop)
// as a safety net. Everything else -- the +1R scale-out (an "exit" with a
// "quantity"), target, breakeven, trailing stop, RSI exit and session flatten --
// is managed here and sent as an exit when it fills. In TradersPost, verify
// that (1) partial exits by quantity are allowed and (2) an exit also cancels or
// resizes the broker-side stop. If not, turn off "Attach broker-side stop".
// IMPORTANT: margin_long/short = 5 in strategy(). With TradingView's default 100% margin the
// tester silently rejects any order whose notional exceeds equity (e.g. 12 MCL at $57 = $68k on a
// $50k account) -- that dropped 41 of the best (tight-stop) trades in the first TradingView run.
// Not compiled in the build environment (no TradingView access) -- if the
// editor flags anything, it is syntax, not logic; the logic mirrors
// trend_lab/strategies/families_v2.py (TrendDipRSI) and families_v3.py (TrendDipATR).

strategy("MCL Trend Dip (15m)", overlay=true, initial_capital=50000, pyramiding=0,
     default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=false,
     process_orders_on_close=false, margin_long=5, margin_short=5, commission_type=strategy.commission.cash_per_contract,
     commission_value=0.62, slippage=1)

// ---------------- Inputs ----------------
sizingMode     = input.string("Cushion", "Sizing", options=["Cushion", "Fixed"], group="Risk (Lucid 50K)",
     tooltip="Cushion: risk = % of the distance between the account balance and Lucid's trailing max-loss line, clamped. Monte Carlo (full-year, conservative, with the kill switch on): 25% / $200-$600 passed ~64% with ~10% fails (funded breach ~9%); without the kill switch use 20% / $150-$500.")
fixedRiskUsd   = input.float(300.0, "Fixed risk per trade (USD)", minval=50, group="Risk (Lucid 50K)")
cushionPct     = input.float(25.0, "Cushion %", minval=1, maxval=100, group="Risk (Lucid 50K)")
cushionMin     = input.float(200.0, "Cushion sizing: min risk (USD)", group="Risk (Lucid 50K)")
cushionMax     = input.float(600.0, "Cushion sizing: max risk (USD)", group="Risk (Lucid 50K)")
acctStart      = input.time(timestamp("2026-10-06T00:00:00"), "Account start (eval/funded day 1)", group="Risk (Lucid 50K)",
     tooltip="Cushion is tracked from the strategy's own P&L since this date. Set it to the day your eval or funded account started; before it, fixed risk is used.")
maxLossUsd     = input.float(2000.0, "Lucid max loss (EOD trailing)", group="Risk (Lucid 50K)")
useEcf         = input.bool(true, "Equity-curve kill switch", group="Risk (Lucid 50K)",
     tooltip="Only send live webhook orders while this strategy's closed-trade equity is at/above the average of its last N closed-trade equity values. The strategy keeps trading on TradingView (shadow trades) so it can switch back on. Untuned classic rule: cut the Oct-Mar drawdown from $2,208 to $1,645 and raised PF in both halves of the year.")
ecfLen         = input.int(20, "Kill switch: lookback (trades)", minval=5, group="Risk (Lucid 50K)")
maxContracts   = input.int(20, "Max contracts", minval=1, group="Risk (Lucid 50K)")
dailyLossMult  = input.float(2.25, "Daily loss stop (x risk)", minval=0.5, group="Risk (Lucid 50K)")
dailyProfitCap = input.float(1200.0, "Stop entering after daily profit (USD)", group="Risk (Lucid 50K)")
maxTradesDay   = input.int(6, "Max trades per day", minval=1, group="Risk (Lucid 50K)")
costPerContract = input.float(3.24, "Cost per contract RT incl. slippage (sizing only)", group="Risk (Lucid 50K)")
maxStopPts     = input.float(1.50, "Skip signals with stop wider than (points)", group="Risk (Lucid 50K)")
eiaFilter      = input.bool(true, "No entries Wed 10:15-10:45 ET (EIA)", group="Risk (Lucid 50K)")
sendBracket    = input.bool(true, "Attach broker-side stop to entries", group="Alerts",
     tooltip="Entry webhooks carry a protective stop at the initial stop price (safety net if TradingView/TradersPost is down). No broker-side take-profit is sent: targets, the scale-out, breakeven, trailing and flatten are all sent from here as exits.")
useA           = input.bool(true, "Engine A: ATR dip", group="Engines")
useB           = input.bool(true, "Engine B: RSI dip", group="Engines")
pointValue     = 100.0  // MCL: $1 per 0.01

// Engine A
aHtfTf   = input.timeframe("60", "A: HTF", group="Engine A")
aHtfLen  = input.int(50, "A: HTF EMA", group="Engine A")
aSlope   = input.int(12, "A: HTF slope bars", group="Engine A")
aBaseLen = input.int(100, "A: base EMA", group="Engine A")
aFast    = input.int(13, "A: fast EMA", group="Engine A")
aDipK    = input.float(1.0, "A: dip depth (ATR)", group="Engine A")
aDipBars = input.int(6, "A: dip lookback bars", group="Engine A")
aSwing   = input.int(8, "A: swing stop lookback", group="Engine A")
aTarget  = input.float(2.0, "A: target R", group="Engine A")
aBE      = input.float(1.0, "A: breakeven at R", group="Engine A")
aTrail   = input.float(2.5, "A: trail ATR", group="Engine A")
aScaleR  = input.float(1.0, "A: scale out half at R (0 = off)", minval=0, group="Engine A",
     tooltip="Take half the contracts off at +1R, the rest keeps the normal exits. Untuned textbook rule. Full-year Monte Carlo (kill switch on, 25% cushion): eval fail 9.9% -> 2.2%, pass 63.5% -> 71.1%, funded breach 8.6% -> 2.1%.")
aMaxBars = input.int(0, "A: time stop (bars, 0 = off)", minval=0, group="Engine A",
     tooltip="Walk-forward (iteration 9) chose a 12-bar time stop with a 3R target and no breakeven in every window; modest evidence, so off by default.")

// Engine B
bHtfTf   = input.timeframe("240", "B: HTF", group="Engine B")
bHtfLen  = input.int(50, "B: HTF EMA", group="Engine B")
bBaseLen = input.int(100, "B: base EMA", group="Engine B")
bRsiLen  = input.int(3, "B: RSI length", group="Engine B")
bRsiLo   = input.float(30, "B: RSI dip level", group="Engine B")
bRsiExit = input.float(70, "B: RSI exit level", group="Engine B")
bSwing   = input.int(5, "B: swing stop lookback", group="Engine B")
bTarget  = input.float(3.0, "B: target R", group="Engine B")
bTrail   = input.float(3.0, "B: trail ATR", group="Engine B")

// ---------------- Time helpers (ET) ----------------
tz = "America/New_York"
barMinutes = timeframe.in_seconds() / 60
closeT = time + timeframe.in_seconds() * 1000
closeMod = hour(closeT, tz) * 60 + minute(closeT, tz)
openMod  = hour(time, tz) * 60 + minute(time, tz)
isWed    = dayofweek(closeT, tz) == dayofweek.wednesday
inMaint  = openMod >= 16 * 60 and openMod < 18 * 60
eiaBlock = eiaFilter and isWed and closeMod >= 10 * 60 + 15 and closeMod <= 10 * 60 + 45
winA = closeMod >= 8 * 60 and closeMod <= 14 * 60 + 30 and not inMaint and not eiaBlock
winB = closeMod >= 9 * 60 and closeMod <= 13 * 60 + 30 and not inMaint and not eiaBlock
// next bar opens at closeMod; flatten at the open of the first bar at/after the cutoff
flatA = closeMod >= 16 * 60 + 30 and closeMod < 18 * 60
flatB = closeMod >= 14 * 60 + 30 and closeMod < 18 * 60

// ---------------- Cushion tracking (Lucid EOD trailing max loss) ----------------
// Balance and high-water mark measured from acctStart using the closed P&L of LIVE trades only
// (shadow trades taken while the kill switch is off never reach the account).
var bool  liveTrade = true
var float liveNet = 0.0
var int   seenClosed = 0
if strategy.closedtrades > seenClosed
    for i = seenClosed to strategy.closedtrades - 1
        if liveTrade
            liveNet += strategy.closedtrades.profit(i)
    seenClosed := strategy.closedtrades
var float acctBase = na
if na(acctBase) and time >= acctStart
    acctBase := liveNet
acctBal = na(acctBase) ? 0.0 : liveNet - acctBase
var float eodPeak = 0.0
// EOD high-water mark updates at the 17:00 ET close (first bar of the 18:00 reopen sees it)
if not na(acctBase) and hour(time, tz) == 18 and minute(time, tz) == 0
    eodPeak := math.max(eodPeak, acctBal)
mllLine = math.min(eodPeak - maxLossUsd, 0.0)
riskUsd = sizingMode == "Fixed" or na(acctBase) ? fixedRiskUsd : math.max(cushionMin, math.min(cushionMax, cushionPct / 100 * (acctBal - mllLine)))

// Trading day rolls at 18:00 ET (CME session); reset daily counters there.
newDay = hour(time, tz) == 18 and minute(time, tz) == 0
var float dayStartProfit = 0.0
var int   dayTrades = 0
if newDay or barstate.isfirst
    dayStartProfit := strategy.netprofit
    dayTrades := 0
dayPnl = strategy.netprofit - dayStartProfit

// ---------------- Indicators ----------------
atr = ta.atr(14)
// lookahead_off: an HTF value is only used once that HTF bar has closed (no repaint on history)
aHtf = request.security(syminfo.tickerid, aHtfTf, ta.ema(close, aHtfLen), lookahead=barmerge.lookahead_off)
bHtf = request.security(syminfo.tickerid, bHtfTf, ta.ema(close, bHtfLen), lookahead=barmerge.lookahead_off)
aBase = ta.ema(close, aBaseLen)
aF    = ta.ema(close, aFast)
bBase = ta.ema(close, bBaseLen)
rsi   = ta.rsi(close, bRsiLen)

// Engine A
aUp = close > aHtf and aHtf - aHtf[aSlope] > 0 and close > aBase
aDn = close < aHtf and aHtf - aHtf[aSlope] < 0 and close < aBase
aDipL = ta.highest(low <= aF - aDipK * atr ? 1 : 0, aDipBars) > 0
aDipS = ta.highest(high >= aF + aDipK * atr ? 1 : 0, aDipBars) > 0
aLong  = useA and aUp and aDipL and close > high[1]
aShort = useA and aDn and aDipS and close < low[1]
aStopL = close - ta.lowest(low, aSwing) + 0.1 * atr
aStopS = ta.highest(high, aSwing) - close + 0.1 * atr

// Engine B
bBias = close > bHtf ? 1 : close < bHtf ? -1 : 0
bUp = bBias > 0 and close > bBase and bBase > bBase[3]
bDn = bBias < 0 and close < bBase and bBase < bBase[3]
bLong  = useB and bUp and rsi[1] < bRsiLo and rsi >= bRsiLo and close > high[1]
bShort = useB and bDn and rsi[1] > 100 - bRsiLo and rsi <= 100 - bRsiLo and close < low[1]
bStopL = close - ta.lowest(low, bSwing) + 0.1 * atr
bStopS = ta.highest(high, bSwing) - close + 0.1 * atr

// ---------------- Position state ----------------
var int   posEngine = 0      // 1 = A, 2 = B
var float riskPts  = na
var float stopPx   = na
var float targetPx = na
var float bestPx   = na
var float pendDist = na
var int   entryBar = na
var int   partQty = 0
var int   entryQty = 0
var float partPx = na

// Equity-curve kill switch: closed-trade equity history
var array<float> eqHist = array.new_float()
if strategy.closedtrades > array.size(eqHist)
    array.push(eqHist, strategy.netprofit)
ecfLive = not useEcf or array.size(eqHist) < ecfLen or
     array.get(eqHist, array.size(eqHist) - 1) >= array.avg(array.slice(eqHist, array.size(eqHist) - ecfLen, array.size(eqHist)))
var int   pendEngine = 0
var int   pendPart = 0
var int   pendQty = 0

exitMsgLive = '{"ticker":"' + syminfo.ticker + '","action":"exit"}'
// shadow trades (kill switch off when the entry was placed) send an empty message; set TradersPost to ignore/blank payloads
exitMsg = liveTrade ? exitMsgLive : ""

// A fill happened on this bar's open: anchor stop/target to the real fill price
if strategy.position_size != 0 and strategy.position_size[1] == 0
    dir = math.sign(strategy.position_size)
    posEngine := pendEngine
    riskPts := pendDist
    stopPx := strategy.position_avg_price - dir * riskPts
    targetPx := strategy.position_avg_price + dir * riskPts * (posEngine == 1 ? aTarget : bTarget)
    bestPx := strategy.position_avg_price
    entryBar := bar_index
    partQty := posEngine == 1 ? pendPart : 0
    entryQty := pendQty
    partPx := strategy.position_avg_price + dir * riskPts * aScaleR

// End-of-bar management: breakeven, chandelier trail, signal exits, flatten
if strategy.position_size != 0
    dir = math.sign(strategy.position_size)
    bestPx := dir > 0 ? math.max(bestPx, high) : math.min(bestPx, low)
    if posEngine == 1 and (bestPx - strategy.position_avg_price) * dir >= aBE * riskPts
        be = strategy.position_avg_price + dir * 2 * syminfo.mintick
        stopPx := dir > 0 ? math.max(stopPx, be) : math.min(stopPx, be)
    trail = bestPx - dir * (posEngine == 1 ? aTrail : bTrail) * atr
    stopPx := dir > 0 ? math.max(stopPx, trail) : math.min(stopPx, trail)
    // the partial has filled once the position is smaller than what was entered (also on the entry bar)
    if partQty > 0 and math.abs(strategy.position_size) < entryQty
        partQty := 0
    // explicit quantities on BOTH exits: the partial gets partQty, the main exit the rest
    // (do not rely on Pine's order-creation allocation)
    mainQty = math.abs(strategy.position_size) - partQty
    if partQty > 0
        partMsg = liveTrade ? '{"ticker":"' + syminfo.ticker + '","action":"exit","quantity":' + str.tostring(partQty) + '}' : ""
        strategy.exit("PL", from_entry="L", qty=partQty, stop=stopPx, limit=partPx, alert_message=partMsg)
        strategy.exit("PS", from_entry="S", qty=partQty, stop=stopPx, limit=partPx, alert_message=partMsg)
    strategy.exit("XL", from_entry="L", qty=mainQty, stop=stopPx, limit=targetPx, alert_message=exitMsg)
    strategy.exit("XS", from_entry="S", qty=mainQty, stop=stopPx, limit=targetPx, alert_message=exitMsg)
    rsiExit = posEngine == 2 and ((dir > 0 and rsi > bRsiExit) or (dir < 0 and rsi < 100 - bRsiExit))
    if rsiExit
        strategy.close_all(comment="rsi_exit", alert_message=exitMsg)
    if posEngine == 1 and aMaxBars > 0 and bar_index - entryBar + 1 >= aMaxBars
        strategy.close_all(comment="time_stop", alert_message=exitMsg)
    if (posEngine == 1 and flatA) or (posEngine == 2 and flatB)
        strategy.close_all(comment="session_flatten", alert_message=exitMsg)

// ---------------- Entries ----------------
// a partial that never filled must not attach to the next entry
if strategy.position_size == 0
    strategy.cancel("PL")
    strategy.cancel("PS")
canEnter = strategy.position_size == 0 and dayTrades < maxTradesDay and -dayPnl < dailyLossMult * riskUsd and dayPnl < dailyProfitCap

int dirSig = 0
float dist = na
int eng = 0
if aLong and winA
    dirSig := 1, dist := aStopL, eng := 1
else if aShort and winA
    dirSig := -1, dist := aStopS, eng := 1
else if bLong and winB
    dirSig := 1, dist := bStopL, eng := 2
else if bShort and winB
    dirSig := -1, dist := bStopS, eng := 2

dist := math.max(nz(dist), 3 * syminfo.mintick)
qty = math.min(maxContracts, math.floor(riskUsd / (dist * pointValue + costPerContract)))

if canEnter and dirSig != 0 and dist <= maxStopPts and qty >= 1
    pendDist := dist
    pendEngine := eng
    pendPart := eng == 1 and aScaleR > 0 and qty >= 2 ? int(math.floor(qty / 2)) : 0
    pendQty := int(qty)
    dayTrades += 1
    liveTrade := ecfLive
    // provisional bracket from the signal close; re-anchored to the fill on the next bar
    sp = close - dirSig * dist
    tp = close + dirSig * dist * (eng == 1 ? aTarget : bTarget)
    msg = '{"ticker":"' + syminfo.ticker + '","action":"' + (dirSig > 0 ? "buy" : "sell") + '","orderType":"market"' +
         ',"quantity":' + str.tostring(qty) +
         (sendBracket ? ',"stopLoss":{"type":"stop","stopPrice":' + str.tostring(sp, format.mintick) + '}' : '') + '}'
    // explicit quantities: partial ("PL"/"PS") = pendPart, main exit ("XL"/"XS") = the rest
    pp = close + dirSig * dist * aScaleR
    mq = int(qty) - pendPart
    ppMsg = ecfLive ? '{"ticker":"' + syminfo.ticker + '","action":"exit","quantity":' + str.tostring(pendPart) + '}' : ""
    if dirSig > 0
        strategy.entry("L", strategy.long, qty=qty, comment=(eng == 1 ? "A long" : "B long") + (ecfLive ? "" : " (shadow)"), alert_message=ecfLive ? msg : "")
        if pendPart > 0
            strategy.exit("PL", from_entry="L", qty=pendPart, stop=sp, limit=pp, alert_message=ppMsg)
        strategy.exit("XL", from_entry="L", qty=mq, stop=sp, limit=tp, alert_message=ecfLive ? exitMsgLive : "")
    else
        strategy.entry("S", strategy.short, qty=qty, comment=(eng == 1 ? "A short" : "B short") + (ecfLive ? "" : " (shadow)"), alert_message=ecfLive ? msg : "")
        if pendPart > 0
            strategy.exit("PS", from_entry="S", qty=pendPart, stop=sp, limit=pp, alert_message=ppMsg)
        strategy.exit("XS", from_entry="S", qty=mq, stop=sp, limit=tp, alert_message=ecfLive ? exitMsgLive : "")

// ---------------- Plots ----------------
plot(aHtf, "1h EMA50", color=color.new(color.blue, 0), linewidth=2)
plot(bHtf, "4h EMA50", color=color.new(color.purple, 30))
plot(aF, "EMA13", color=color.new(color.gray, 40))
plot(strategy.position_size != 0 ? stopPx : na, "Stop", color=color.red, style=plot.style_linebr)
plot(strategy.position_size != 0 ? targetPx : na, "Target", color=color.green, style=plot.style_linebr)
bgcolor(winA ? color.new(color.blue, 95) : na)

//@version=6
// MA pullback strategy for MCL, ported 1:1 from ma_pullback/strategy.py.
//
// Rules (short side; the optional long side is the exact mirror, off by default):
//   1. Bias: fast MA (9) above slow MA (20) -> look for shorts only.
//   2. Setup: wait for a strategy-timeframe bar to CLOSE below both MAs.
//   3. Entry: a sell limit rests on EACH MA. The first one hit is the trade,
//      the other is cancelled (OCA group). While waiting, both limits follow
//      the MAs, re-priced at every strategy-timeframe close.
//   4. The setup is cancelled if the fast MA is no longer above the slow MA,
//      or after "Setup expiry" bars unfilled (0 = never).
//   5. Exit (default "Swing"): stop at the most recent confirmed swing high
//      above each limit (pivot with "Swing strength" lower highs each side,
//      plus an optional tick buffer). If no swing high above a limit exists,
//      that limit isn't placed. Target = R multiple of the risk (1:1 default),
//      measured from the limit price. "Ticks" mode uses a fixed stop instead.
//
// The expiry and MA type are added settings: the spec defined only
// bias/setup/entry, and the swing stop with 1:1 came from a follow-up.
//
// TIMEFRAME: "Strategy timeframe" (default 30m) is where the MAs and the
// close-below-both check are computed. Run the chart on that timeframe for
// an exact match with the Python backtest. A lower chart timeframe also
// works (fills are then checked on the finer bars). In that case the setup is
// read from the completed strategy-timeframe bar, which is non-repainting
// but arms one chart bar late. The chart timeframe must not be higher than
// the strategy timeframe.
//
// Alerts (TradersPost format): create the alert with condition
// "Order fills and alert() function calls". Each entry fill sends the JSON
// in its alert_message (market order with stop + take profit attached).

strategy("MA Pullback (MCL)", overlay=true, initial_capital=10000,
     default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0,
     calc_on_every_tick=false, process_orders_on_close=false)

// ---- Inputs ----
tf          = input.timeframe("30", "Strategy timeframe")
maType      = input.string("SMA", "MA type", options=["SMA", "EMA"])
fastLen     = input.int(9, "Fast MA length", minval=1)
slowLen     = input.int(20, "Slow MA length", minval=1)
enableShort = input.bool(true, "Trade shorts (fast MA above slow MA)")
enableLong  = input.bool(false, "Trade longs (mirror: fast below slow, close above both)")
expiryBars  = input.int(0, "Setup expiry (strategy-TF bars, 0 = never)", minval=0)
stopMode    = input.string("Swing", "Stop placement", options=["Swing", "Ticks"], group="Exits")
swingLen    = input.int(2, "Swing strength (bars each side)", minval=1, group="Exits")
swingBuf    = input.int(0, "Swing buffer (ticks beyond the swing)", minval=0, group="Exits")
stopTicks   = input.int(30, "Stop (ticks from limit, Ticks mode)", minval=1, group="Exits")
targetR     = input.float(1.0, "Target (R multiple)", minval=0.1, step=0.1, group="Exits")
qty         = input.int(1, "Contracts", minval=1, group="Exits")

if timeframe.in_seconds(timeframe.period) > timeframe.in_seconds(tf)
    runtime.error("Chart timeframe must be lower than or equal to the Strategy timeframe.")

ma(src, len) => maType == "EMA" ? ta.ema(src, len) : ta.sma(src, len)

// ---- Strategy-timeframe values from the last COMPLETED bar ----
sameTF = timeframe.in_seconds(timeframe.period) == timeframe.in_seconds(tf)
maFastChart = ma(close, fastLen)
maSlowChart = ma(close, slowLen)
phChart = ta.pivothigh(high, swingLen, swingLen)
plChart = ta.pivotlow(low, swingLen, swingLen)
[fastHTF, slowHTF, closeHTF, phHTF, plHTF] = request.security(syminfo.tickerid, tf,
     [ma(close, fastLen)[1], ma(close, slowLen)[1], close[1],
      ta.pivothigh(high, swingLen, swingLen)[1], ta.pivotlow(low, swingLen, swingLen)[1]],
     lookahead=barmerge.lookahead_on)

fastMA  = sameTF ? maFastChart : fastHTF
slowMA  = sameTF ? maSlowChart : slowHTF
tfClose = sameTF ? close : closeHTF
tfBarDone = sameTF ? true : timeframe.change(tf)   // a strategy-TF bar just completed
newSwingHigh = sameTF ? phChart : phHTF            // pivot confirmed on the completed bar, else na
newSwingLow  = sameTF ? plChart : plHTF

// Confirmed swings, oldest first (capped).
var array<float> swingHighs = array.new_float()
var array<float> swingLows  = array.new_float()
if tfBarDone
    if not na(newSwingHigh)
        array.push(swingHighs, newSwingHigh)
        if array.size(swingHighs) > 200
            array.shift(swingHighs)
    if not na(newSwingLow)
        array.push(swingLows, newSwingLow)
        if array.size(swingLows) > 200
            array.shift(swingLows)

// Stop for a limit: most recent swing beyond it (Swing mode) or fixed ticks. na = don't place.
f_stop(isShort, limitPx) =>
    float result = na
    if stopMode == "Ticks"
        result := isShort ? limitPx + stopTicks * syminfo.mintick : limitPx - stopTicks * syminfo.mintick
    else
        arr = isShort ? swingHighs : swingLows
        n = array.size(arr)
        if n > 0
            for j = n - 1 to 0
                x = array.get(arr, j)
                if isShort and x > limitPx
                    result := x + swingBuf * syminfo.mintick
                    break
                if not isShort and x < limitPx
                    result := x - swingBuf * syminfo.mintick
                    break
    result

// ---- Setup state machine (evaluated once per completed strategy-TF bar) ----
var string armed = na
var int armedBars = 0
var float limFast = na
var float limSlow = na

flat = strategy.position_size == 0
// A fill ends the setup (one trade per setup), even if the trade already
// closed on the same bar.
var int lastTradeCount = 0
tradeCount = strategy.opentrades + strategy.closedtrades
if tradeCount != lastTradeCount
    armed := na
    lastTradeCount := tradeCount

if tfBarDone and not na(fastMA) and not na(slowMA)
    shortBias = enableShort and fastMA > slowMA
    longBias  = enableLong and fastMA < slowMA
    if (armed == "short" and not shortBias) or (armed == "long" and not longBias)
        armed := na
    if not na(armed)
        armedBars += 1
        if expiryBars > 0 and armedBars > expiryBars
            armed := na
    if na(armed) and flat
        if shortBias and tfClose < math.min(fastMA, slowMA)
            armed := "short"
            armedBars := 0
        else if longBias and tfClose > math.max(fastMA, slowMA)
            armed := "long"
            armedBars := 0
    limFast := fastMA
    limSlow := slowMA

// ---- Orders ----
f_msg(action, entry, stop, target) =>
    '{"ticker":"' + syminfo.ticker + '","action":"' + action + '","orderType":"market"' +
     ',"quantity":' + str.tostring(qty) +
     ',"signalPrice":' + str.tostring(entry, format.mintick) +
     ',"stopLoss":{"type":"stop","stopPrice":' + str.tostring(stop, format.mintick) + '}' +
     ',"takeProfit":{"limitPrice":' + str.tostring(target, format.mintick) + '}}'

// Places (or re-prices) one limit with its stop/target, or cancels it if no valid stop exists.
f_order(id, isShort, limitRaw) =>
    px = math.round_to_mintick(limitRaw)
    st = f_stop(isShort, px)
    if na(st)
        strategy.cancel(id)
    else
        st := math.round_to_mintick(st)
        risk = math.abs(st - px)
        tg = math.round_to_mintick(isShort ? px - risk * targetR : px + risk * targetR)
        strategy.entry(id, isShort ? strategy.short : strategy.long, qty=qty, limit=px,
             oca_name="setup", oca_type=strategy.oca.cancel,
             alert_message=f_msg(isShort ? "sell" : "buy", px, st, tg))
        strategy.exit(id + " x", from_entry=id, stop=st, limit=tg)

if flat and armed == "short"
    f_order("S fast", true, limFast)
    f_order("S slow", true, limSlow)
else if flat and armed == "long"
    f_order("L fast", false, limFast)
    f_order("L slow", false, limSlow)
else if flat
    strategy.cancel("S fast")
    strategy.cancel("S slow")
    strategy.cancel("L fast")
    strategy.cancel("L slow")

// ---- Visuals ----
plot(fastMA, "Fast MA", color=color.orange, linewidth=2)
plot(slowMA, "Slow MA", color=color.blue, linewidth=2)
bgcolor(armed == "short" ? color.new(color.red, 90) : armed == "long" ? color.new(color.green, 90) : na, title="Setup armed")

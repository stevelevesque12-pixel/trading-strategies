//@version=6
// 9/20 SMA "limit back at the 20" strategy, ported from ma_limit/strategy.py
// (live_mode="realtime"). Built for MCL1! on the 30-minute chart.
//
//   Short: 9 SMA above 20 SMA and a candle closes below both -> sell limit at the 20 SMA.
//   Long:  9 SMA below 20 SMA and a candle closes above both -> buy limit at the 20 SMA.
//   Stop = SL x ATR(14) from the entry, target = R multiple of the stop (2R by default).
//
//   - The limit works for "Entry window" candles after the setup candle closes, then is
//     cancelled. A new setup while waiting restarts the window at the new 20 SMA.
//   - It is NOT cancelled when the 9 and 20 cross back.
//   - One trade at a time, held to SL or TP, then look for the next setup. Trades are held overnight
//     and over weekends unless "Flatten before the close" is on.
//   - "Trading hours": untick an hour to skip setup candles that open in it (ET by default).
//     It only filters which setups count; open trades still run to SL/TP.
//   - "End of day": when "Flatten before the close" is on, any open trade is closed at the open of the
//     first candle at/after the chosen time (ET), working orders are cancelled, and nothing new is placed
//     until the 18:00 reopen. Use it for prop firms that don't allow overnight holds (e.g. Tradeify).
//     On early-close holidays (e.g. Presidents Day) the market halts before the flatten time; the script
//     can't see that coming, so a trade still open then is carried (the firm closes it at its cutoff).
//   - "Filters": a volatility filter (only take setups when ATR is at least X times its average over the
//     last N candles; 1000 x 30m is about a month) and weekday switches. Both off by default.
//   - "Position sizing": a fixed number of contracts, or a fixed $ risk per trade
//     (contracts = $ risk / (stop distance x point value), rounded down, capped at the max).
//
// The limit sits where price meets the forming candle's live 20 SMA, which is the average of
// the previous 19 closes (known when the candle opens), and the stop uses the last closed
// candle's ATR -- so nothing here peeks at a candle before it closes.

// Commission: Tradeify MCL, $2.12 round trip per contract = $1.06 per side.
strategy("MA 9/20 limit at the 20", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.fixed, default_qty_value = 1, margin_long = 0, margin_short = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 1.06,
     slippage = 1, process_orders_on_close = false)

grpRules = "Rules"
fastLen  = input.int(9, "Fast SMA", minval = 1, group = grpRules)
slowLen  = input.int(20, "Slow SMA (entry)", minval = 2, group = grpRules)
atrLen   = input.int(14, "ATR length", minval = 1, group = grpRules)
slMult   = input.float(2.0, "Stop loss (x ATR)", minval = 0.1, step = 0.25, group = grpRules)
rr       = input.float(2.0, "Target (x stop distance)", minval = 0.1, step = 0.25, group = grpRules)
window   = input.int(2, "Entry window (candles after setup)", minval = 1, group = grpRules)

grpEod     = "End of day"
flatOn     = input.bool(false, "Flatten before the close", group = grpEod,
     tooltip = "On: close any open trade and cancel working orders at the time below (in the trading-hours time zone), with no new orders until the 18:00 reopen. Off: trades are held overnight and over weekends until SL or TP.")
flatHour   = input.int(16, "Flatten at (hour)", minval = 0, maxval = 23, group = grpEod, inline = "flat")
flatMinute = input.int(30, "minute", minval = 0, maxval = 59, step = 15, group = grpEod, inline = "flat")

grpFilt  = "Filters"
volOn    = input.bool(false, "Volatility filter", group = grpFilt,
     tooltip = "Only take setups when ATR(14) is at least the multiple below times its average over the last N candles. Needs N candles of history before it allows any trade.")
volMult  = input.float(1.0, "ATR at least x its average", minval = 0.1, step = 0.1, group = grpFilt, inline = "vol")
volLen   = input.int(1000, "over N candles", minval = 2, group = grpFilt, inline = "vol")
skipMon  = input.bool(false, "Skip Mon", group = grpFilt, inline = "days")
skipTue  = input.bool(false, "Tue", group = grpFilt, inline = "days")
skipWed  = input.bool(false, "Wed", group = grpFilt, inline = "days")
skipThu  = input.bool(false, "Thu", group = grpFilt, inline = "days")
skipFri  = input.bool(false, "Fri", group = grpFilt, inline = "days")

grpSize   = "Position sizing"
sizeMode  = input.string("Fixed contracts", "Mode", options = ["Fixed contracts", "Fixed $ risk"], group = grpSize)
fixedQty  = input.int(1, "Contracts (fixed contracts mode)", minval = 1, group = grpSize)
riskUsd   = input.float(100, "$ risk per trade (fixed $ risk mode)", minval = 1, step = 25, group = grpSize)
maxQty    = input.int(50, "Max contracts (fixed $ risk mode)", minval = 1, group = grpSize)
skipSmall = input.bool(true, "Skip trade if the stop is too wide for 1 contract", group = grpSize,
     tooltip = "Fixed $ risk mode: when one contract would already risk more than the $ amount, skip the trade (on) or take 1 contract anyway (off).")

grpHours = "Trading hours (hour the setup candle opens in)"
hoursTz  = input.string("America/New_York", "Time zone", group = grpHours)
h00 = input.bool(false, "00:00", group = grpHours, inline = "row0")
h01 = input.bool(false, "01:00", group = grpHours, inline = "row0")
h02 = input.bool(false, "02:00", group = grpHours, inline = "row0")
h03 = input.bool(false, "03:00", group = grpHours, inline = "row0")
h04 = input.bool(false, "04:00", group = grpHours, inline = "row1")
h05 = input.bool(false, "05:00", group = grpHours, inline = "row1")
h06 = input.bool(false, "06:00", group = grpHours, inline = "row1")
h07 = input.bool(false, "07:00", group = grpHours, inline = "row1")
h08 = input.bool(false, "08:00", group = grpHours, inline = "row2")
h09 = input.bool(false, "09:00", group = grpHours, inline = "row2")
h10 = input.bool(true, "10:00", group = grpHours, inline = "row2")
h11 = input.bool(true, "11:00", group = grpHours, inline = "row2")
h12 = input.bool(true, "12:00", group = grpHours, inline = "row3")
h13 = input.bool(true, "13:00", group = grpHours, inline = "row3")
h14 = input.bool(true, "14:00", group = grpHours, inline = "row3")
h15 = input.bool(false, "15:00", group = grpHours, inline = "row3")
h16 = input.bool(false, "16:00", group = grpHours, inline = "row4")
h17 = input.bool(false, "17:00", group = grpHours, inline = "row4")
h18 = input.bool(false, "18:00", group = grpHours, inline = "row4")
h19 = input.bool(false, "19:00", group = grpHours, inline = "row4")
h20 = input.bool(false, "20:00", group = grpHours, inline = "row5")
h21 = input.bool(false, "21:00", group = grpHours, inline = "row5")
h22 = input.bool(false, "22:00", group = grpHours, inline = "row5")
h23 = input.bool(false, "23:00", group = grpHours, inline = "row5")
hourOn = array.from(h00, h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11,
     h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23)

fast = ta.sma(close, fastLen)
slow = ta.sma(close, slowLen)
atr  = ta.atr(atrLen)

inHours    = array.get(hourOn, hour(time, hoursTz))
// The next candle opens when this one closes; flatten if that falls between the flatten time and the 18:00 reopen.
nextOpenMins = hour(time_close, hoursTz) * 60 + minute(time_close, hoursTz)
flatWindow   = flatOn and nextOpenMins >= flatHour * 60 + flatMinute and nextOpenMins < 18 * 60
dow        = dayofweek(time, hoursTz)
daySkipped = (dow == dayofweek.monday and skipMon) or (dow == dayofweek.tuesday and skipTue) or
     (dow == dayofweek.wednesday and skipWed) or (dow == dayofweek.thursday and skipThu) or (dow == dayofweek.friday and skipFri)
atrAvg     = ta.sma(atr, volLen)
volOk      = not volOn or (not na(atrAvg) and atr >= volMult * atrAvg)
shortSetup = fast > slow and close < math.min(fast, slow) and volOk and not daySkipped
longSetup  = fast < slow and close > math.max(fast, slow) and volOk and not daySkipped

var int pendDir  = 0  // 1 = working buy limit, -1 = working sell limit, 0 = none
var int barsLeft = 0
flat = strategy.position_size == 0

// The working order filled on this candle, or this candle used up one of its window.
if not flat
    pendDir := 0
if pendDir != 0
    barsLeft -= 1
    if barsLeft <= 0
        pendDir := 0

// End of day: out at the next candle's open, no working orders until the reopen.
if flatWindow
    pendDir := 0
    if not flat
        strategy.close_all(comment = "EOD flat")

// A new setup (only while flat) places / re-anchors the order.
if flat and inHours and not flatWindow and (shortSetup or longSetup)
    pendDir  := shortSetup ? -1 : 1
    barsLeft := window

// Price for the next candle: where it meets that candle's live 20 SMA.
touch = math.round_to_mintick(math.sum(close, slowLen - 1) / (slowLen - 1))
risk  = math.round_to_mintick(slMult * atr)

// Contracts for this order. Commission and slippage are not included in the $ risk.
riskPerContract = risk * syminfo.pointvalue
rawQty = sizeMode == "Fixed contracts" ? fixedQty : math.floor(riskUsd / riskPerContract)
qty    = sizeMode == "Fixed contracts" ? fixedQty : math.min(maxQty, rawQty >= 1 ? rawQty : (skipSmall ? 0 : 1))

if flat and (qty == 0 or flatWindow)
    strategy.cancel("Long")
    strategy.cancel("Short")
else if flat
    if pendDir == 1
        strategy.cancel("Short")
        strategy.entry("Long", strategy.long, qty = qty, limit = touch)
        strategy.exit("Long exit", "Long", stop = touch - risk, limit = touch + rr * risk)
    else if pendDir == -1
        strategy.cancel("Long")
        strategy.entry("Short", strategy.short, qty = qty, limit = touch)
        strategy.exit("Short exit", "Short", stop = touch + risk, limit = touch - rr * risk)
    else
        strategy.cancel("Long")
        strategy.cancel("Short")

plot(fast, "9 SMA", color = color.white)
plot(slow, "20 SMA", color = color.yellow)
plot(flat and pendDir != 0 ? touch : na, "Working limit", color = color.orange, style = plot.style_linebr)
plotshape(flat and inHours and shortSetup, "Short setup", shape.triangledown, location.abovebar, color.red, size = size.tiny)
plotshape(flat and inHours and longSetup, "Long setup", shape.triangleup, location.belowbar, color.lime, size = size.tiny)

//@version=6
// RSI 80-20 divergence strategy, ported from rsi_8020/strategy.py.
// Runs on whatever timeframe the chart is set to; no session filter, a trade
// stays open until its stop or target is hit. Every setting below is
// adjustable in the script's Settings panel.
//
// Display: the script's own pane shows the RSI with the 80/20 levels and
// dots on the first/second low (high) RSI readings; the entry trigger, stop
// line and entry arrows are drawn on the price chart (force_overlay).
//
// Rules (long case; short is the exact mirror: N-candle high, RSI > 80,
// higher high with lower RSI, close below the first candle's low):
//   1. First low: a candle makes the lowest low of the last N candles
//      (default 50) while RSI is below the oversold level (default 20).
//   2. Second low: a later candle makes a low BELOW the first low, but with
//      a HIGHER RSI than the first low had (bullish divergence). A lower low
//      without a higher RSI just replaces the first low.
//   3. Entry: a later candle closes above the first low candle's high.
//   4. Stop: see the "Stop loss" settings (default: below the second low).
//   5. Target: initial risk x the Risk:Reward setting (default 1:3).
// A setup with no entry within "Setup expires after" candles is dropped.
//
// Alerting (optional): create the TradingView alert with condition "Any
// alert() function call"; the messages are in TradersPost webhook format.
// Only the INITIAL stop is sent in the entry alert -- breakeven and trailing
// stop moves are simulated in TradingView's backtest but are not sent to the
// broker.

strategy("RSI 80-20 Divergence", overlay=false, initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=false)

// ---- Settings ----
G_SETUP = "Setup"
lookback      = input.int(50, "Candles for high/low (50, 45, 40...)", minval=5, step=5, group=G_SETUP)
rsiLength     = input.int(14, "RSI length", minval=1, group=G_SETUP)
oversold      = input.float(20.0, "RSI oversold (longs)", minval=1, maxval=99, step=1, group=G_SETUP)
overbought    = input.float(80.0, "RSI overbought (shorts)", minval=1, maxval=99, step=1, group=G_SETUP)
maxSetupBars  = input.int(50, "Setup expires after (candles)", minval=1, group=G_SETUP)
allowLongs    = input.bool(true, "Take longs", group=G_SETUP)
allowShorts   = input.bool(true, "Take shorts", group=G_SETUP)

G_SL = "Stop loss"
SL_SECOND = "Second low/high (divergence extreme)"
SL_FIRST  = "First low/high (the 50-candle extreme)"
SL_SWING  = "Lowest low / highest high of last N candles"
SL_ATR    = "ATR multiple from entry"
SL_TICKS  = "Fixed ticks from entry"
SL_PCT    = "Percent from entry"
stopMode        = input.string(SL_SECOND, "Stop placement", options=[SL_SECOND, SL_FIRST, SL_SWING, SL_ATR, SL_TICKS, SL_PCT], group=G_SL)
swingStopLen    = input.int(10, "  N candles (for last-N-candles stop)", minval=1, group=G_SL)
stopAtrMult     = input.float(1.5, "  ATR multiple (for ATR stop)", minval=0.1, step=0.1, group=G_SL)
fixedStopTicks  = input.int(20, "  Ticks (for fixed-ticks stop)", minval=1, group=G_SL)
stopPct         = input.float(0.5, "  Percent (for percent stop)", minval=0.01, step=0.05, group=G_SL)
bufferType      = input.string("Ticks", "Buffer beyond the level", options=["Ticks", "ATR"], group=G_SL,
     tooltip="Extra room added beyond the low/high for the three structure-based stops. Ignored by the ATR/ticks/percent stops.")
stopBufferTicks = input.int(2, "  Buffer ticks", minval=0, group=G_SL)
bufferAtrMult   = input.float(0.25, "  Buffer ATR multiple", minval=0.0, step=0.05, group=G_SL)
atrLength       = input.int(14, "ATR length", minval=1, group=G_SL)
minStopTicks    = input.int(0, "Min stop size (ticks, 0 = off)", minval=0, group=G_SL,
     tooltip="Stops tighter than this are widened to this size.")
maxStopTicks    = input.int(0, "Max stop size (ticks, 0 = off)", minval=0, group=G_SL)
wideStopAction  = input.string("Skip trade", "  If stop is wider than max", options=["Skip trade", "Cap stop at max"], group=G_SL)

G_MGMT = "Stop management"
useBreakeven    = input.bool(false, "Move stop to breakeven", group=G_MGMT)
beTriggerR      = input.float(1.0, "  ...once price reaches (R)", minval=0.1, step=0.1, group=G_MGMT)
beOffsetTicks   = input.int(1, "  Breakeven offset (ticks in profit)", minval=0, group=G_MGMT)
TR_OFF   = "Off"
TR_ATR   = "ATR trail"
TR_SWING = "Last N candles low/high"
trailMode       = input.string(TR_OFF, "Trailing stop", options=[TR_OFF, TR_ATR, TR_SWING], group=G_MGMT)
trailStartR     = input.float(1.0, "  Start trailing once price reaches (R)", minval=0.0, step=0.1, group=G_MGMT)
trailAtrMult    = input.float(2.0, "  ATR multiple (ATR trail)", minval=0.1, step=0.1, group=G_MGMT)
trailLen        = input.int(5, "  N candles (low/high trail)", minval=1, group=G_MGMT)

G_EXIT = "Target"
targetR = input.float(3.0, "Risk : Reward  (1 : X)", minval=0.5, step=0.5, group=G_EXIT)

G_SIZE = "Position sizing"
riskPerTradeUsd  = input.float(100.0, "Risk per trade ($)", minval=0.0, step=10, group=G_SIZE)
autoPointValue   = input.bool(true, "Use the symbol's point value automatically", group=G_SIZE)
manualPointValue = input.float(5.0, "Manual point value ($ per point) -- MES=5, MNQ=2", minval=0.0001, group=G_SIZE)
maxContracts     = input.int(5, "Max contracts", minval=1, group=G_SIZE)

G_VIS = "Display"
showLevels  = input.bool(true, "Show entry trigger / stop lines while a setup is live", group=G_VIS)
showTradeSL = input.bool(true, "Show active stop / target while in a trade", group=G_VIS)
showDivDots = input.bool(true, "Mark first / second low (high) on the RSI", group=G_VIS)
rsiColor    = input.color(color.purple, "RSI line color", group=G_VIS)

pointValueUsd = autoPointValue ? syminfo.pointvalue : manualPointValue
tick          = syminfo.mintick

// ---- Core series (computed every candle) ----
rsi        = ta.rsi(close, rsiLength)
atr        = ta.atr(atrLength)
isLowestN  = low  <= ta.lowest(low, lookback)    // includes the current candle
isHighestN = high >= ta.highest(high, lookback)
swingLow   = ta.lowest(low, swingStopLen)
swingHigh  = ta.highest(high, swingStopLen)
trailLow   = ta.lowest(low, trailLen)
trailHigh  = ta.highest(high, trailLen)
bufferPts  = bufferType == "Ticks" ? stopBufferTicks * tick : atr * bufferAtrMult

// ---- Setup state ----
var string setupDir        = na     // "long" / "short"
var float  firstExt        = na     // first low (long) / first high (short)
var float  firstRsi        = na
var float  trigger         = na     // first candle's high (long) / low (short)
var float  secondExt       = na     // lowest divergent low / highest divergent high
var bool   secondConfirmed = false
var int    barsSince       = 0

rawLong     = false
rawShort    = false
triggered   = false
markFirst   = false   // this candle set (or replaced) the first low/high
markSecond  = false   // this candle set/extended the divergent second low/high
float trigFirst  = na  // first/second extremes captured at the trigger candle
float trigSecond = na

if not na(rsi)
    if not na(setupDir)
        barsSince += 1
        isLong = setupDir == "long"

        // Entry uses only state from earlier candles: the second low must
        // have already closed before a later candle can trigger.
        if secondConfirmed and (isLong ? close > trigger : close < trigger)
            triggered  := true
            rawLong    := isLong
            rawShort   := not isLong
            trigFirst  := firstExt
            trigSecond := secondExt
            setupDir   := na
        else
            replaced = false
            if isLong ? low < firstExt : high > firstExt
                ext = isLong ? low : high
                if isLong ? rsi > firstRsi : rsi < firstRsi
                    secondExt := na(secondExt) ? ext : isLong ? math.min(secondExt, ext) : math.max(secondExt, ext)
                    markSecond := true
                else
                    // Deeper extreme without divergence -> new first low/high.
                    firstExt        := ext
                    firstRsi        := rsi
                    trigger         := isLong ? high : low
                    secondExt       := na
                    secondConfirmed := false
                    barsSince       := 0
                    replaced        := true
                    markFirst       := true
            if not replaced
                if not na(secondExt)
                    secondConfirmed := true
                if barsSince >= maxSetupBars
                    setupDir := na

    // No setup in progress (or it just expired): look for a fresh first low/high.
    if na(setupDir) and not triggered
        if allowLongs and isLowestN and rsi < oversold
            setupDir        := "long"
            firstExt        := low
            firstRsi        := rsi
            trigger         := high
            secondExt       := na
            secondConfirmed := false
            barsSince       := 0
            markFirst       := true
        else if allowShorts and isHighestN and rsi > overbought
            setupDir        := "short"
            firstExt        := high
            firstRsi        := rsi
            trigger         := low
            secondExt       := na
            secondConfirmed := false
            barsSince       := 0
            markFirst       := true

// ---- Initial stop ----
initialStop(bool isLong) =>
    float s = switch stopMode
        SL_SECOND => isLong ? math.min(trigSecond, low) - bufferPts : math.max(trigSecond, high) + bufferPts
        SL_FIRST  => isLong ? trigFirst - bufferPts : trigFirst + bufferPts
        SL_SWING  => isLong ? swingLow - bufferPts : swingHigh + bufferPts
        SL_ATR    => isLong ? close - atr * stopAtrMult : close + atr * stopAtrMult
        SL_TICKS  => isLong ? close - fixedStopTicks * tick : close + fixedStopTicks * tick
        => isLong ? close * (1 - stopPct / 100) : close * (1 + stopPct / 100)
    s

float sigEntry  = na
float sigStop   = na
float sigTarget = na
stopOk = false

if rawLong or rawShort
    isLong   = rawLong
    sigEntry := close
    sigStop  := initialStop(isLong)
    dist     = isLong ? close - sigStop : sigStop - close
    stopOk   := dist > 0
    if stopOk and minStopTicks > 0 and dist < minStopTicks * tick
        dist := minStopTicks * tick
    if stopOk and maxStopTicks > 0 and dist > maxStopTicks * tick
        if wideStopAction == "Skip trade"
            stopOk := false
        else
            dist := maxStopTicks * tick
    sigStop   := isLong ? close - dist : close + dist
    sigTarget := isLong ? close + dist * targetR : close - dist * targetR

longSignal  = rawLong  and stopOk
shortSignal = rawShort and stopOk

// ---- Position sizing ----
riskPerContract = longSignal ? (sigEntry - sigStop) * pointValueUsd : shortSignal ? (sigStop - sigEntry) * pointValueUsd : na
qty = (not na(riskPerContract) and riskPerContract > 0) ? math.max(1, math.min(math.floor(riskPerTradeUsd / riskPerContract), maxContracts)) : 0

finalLongSignal  = longSignal  and qty > 0 and strategy.position_size == 0
finalShortSignal = shortSignal and qty > 0 and strategy.position_size == 0

// ---- Open-trade stop management (breakeven / trailing) ----
var string posDir    = na
var float  posStop   = na
var float  posTarget = na
var float  posRisk   = na

if strategy.position_size == 0 and not na(posDir)
    posDir := na

if not na(posDir) and strategy.position_size != 0
    isLong  = posDir == "long"
    entryPx = strategy.position_avg_price
    bestR   = isLong ? (high - entryPx) / posRisk : (entryPx - low) / posRisk
    newStop = posStop

    if useBreakeven and bestR >= beTriggerR
        be = isLong ? entryPx + beOffsetTicks * tick : entryPx - beOffsetTicks * tick
        newStop := isLong ? math.max(newStop, be) : math.min(newStop, be)

    if trailMode != TR_OFF and bestR >= trailStartR
        cand = trailMode == TR_ATR ? (isLong ? close - atr * trailAtrMult : close + atr * trailAtrMult) : (isLong ? trailLow - bufferPts : trailHigh + bufferPts)
        newStop := isLong ? math.max(newStop, cand) : math.min(newStop, cand)

    if newStop != posStop
        posStop := newStop
        strategy.exit(isLong ? "Long Exit" : "Short Exit", from_entry=isLong ? "Long" : "Short", stop=posStop, limit=posTarget)

// ---- Entries + webhook alerts ----
if finalLongSignal
    posDir    := "long"
    posStop   := sigStop
    posTarget := sigTarget
    posRisk   := sigEntry - sigStop
    strategy.entry("Long", strategy.long, qty=qty)
    strategy.exit("Long Exit", from_entry="Long", stop=sigStop, limit=sigTarget)
    longMsg = '{"ticker":"' + syminfo.ticker + '","action":"buy","orderType":"market"' +
         ',"quantity":' + str.tostring(qty) +
         ',"signalPrice":' + str.tostring(sigEntry) +
         ',"stopLoss":{"type":"stop","stopPrice":' + str.tostring(sigStop) + '}' +
         ',"takeProfit":{"limitPrice":' + str.tostring(sigTarget) + '}}'
    alert(longMsg, alert.freq_once_per_bar_close)

if finalShortSignal
    posDir    := "short"
    posStop   := sigStop
    posTarget := sigTarget
    posRisk   := sigStop - sigEntry
    strategy.entry("Short", strategy.short, qty=qty)
    strategy.exit("Short Exit", from_entry="Short", stop=sigStop, limit=sigTarget)
    shortMsg = '{"ticker":"' + syminfo.ticker + '","action":"sell","orderType":"market"' +
         ',"quantity":' + str.tostring(qty) +
         ',"signalPrice":' + str.tostring(sigEntry) +
         ',"stopLoss":{"type":"stop","stopPrice":' + str.tostring(sigStop) + '}' +
         ',"takeProfit":{"limitPrice":' + str.tostring(sigTarget) + '}}'
    alert(shortMsg, alert.freq_once_per_bar_close)

// ---- Visuals: RSI pane ----
hline(overbought, "Overbought", color=color.new(color.red, 40),   linestyle=hline.style_dashed)
hline(50,         "Midline",    color=color.new(color.gray, 60),  linestyle=hline.style_dotted)
hline(oversold,   "Oversold",   color=color.new(color.green, 40), linestyle=hline.style_dashed)
plot(rsi, "RSI", color=rsiColor, linewidth=2)
plotshape(showDivDots and markFirst  ? rsi : na, "First low/high (RSI)",  style=shape.circle, location=location.absolute, color=color.orange, size=size.tiny)
plotshape(showDivDots and markSecond ? rsi : na, "Second low/high (RSI)", style=shape.circle, location=location.absolute, color=color.aqua,   size=size.tiny)

// ---- Visuals: price chart ----
plot(showLevels and not na(setupDir) ? trigger : na, "Entry trigger (first candle high/low)", color=color.new(color.gray, 20), style=plot.style_linebr, linewidth=2, force_overlay=true)
plot(showLevels and not na(setupDir) ? secondExt : na, "Second low/high", color=color.new(color.orange, 20), style=plot.style_linebr, linewidth=2, force_overlay=true)
plot(showTradeSL and not na(posDir) ? posStop : na, "Active stop", color=color.red, style=plot.style_linebr, linewidth=2, force_overlay=true)
plot(showTradeSL and not na(posDir) ? posTarget : na, "Target", color=color.green, style=plot.style_linebr, linewidth=2, force_overlay=true)
plotshape(finalLongSignal,  title="Long",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, force_overlay=true)
plotshape(finalShortSignal, title="Short", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, force_overlay=true)

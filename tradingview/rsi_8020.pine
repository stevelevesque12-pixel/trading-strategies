//@version=6
// RSI 80-20 divergence strategy, ported from rsi_8020/strategy.py.
// Fires TradersPost-format webhook alerts. No session filter or forced
// flatten -- it trades around the clock on whatever timeframe the chart is
// set to, and a trade stays open until its stop or target is hit.
//
// Rules (long case; short is the exact mirror: 50-candle high, RSI > 80,
// higher high with lower RSI, close below the first candle's low):
//   1. First low: a candle makes the lowest low of the last 50 candles while
//      RSI is below 20. Remember its low, its high and its RSI.
//   2. Second low: a later candle makes a low BELOW the first low, but with
//      a HIGHER RSI than the first low had (bullish divergence). A lower low
//      without a higher RSI just replaces the first low. Further lower lows
//      that keep the divergence extend the second low.
//   3. Entry: a later candle closes above the first low candle's high.
//   4. Stop: below the lowest low made after the first low (the second low),
//      minus a tick buffer.
//   5. Target: targetR * risk (default 3R).
// A setup with no entry within "Max setup candles" of its first low is dropped.
//
// Alerting: create the TradingView alert with condition "Any alert()
// function call", webhook URL = your TradersPost strategy's webhook URL
// (auth is in that URL, not a JSON field). See ../TRADINGVIEW_WEBHOOK.md.

strategy("RSI 80-20 Divergence", overlay=true, initial_capital=50000,
     default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=false)

// ---- Inputs ----
rsiLength        = input.int(14, "RSI length", minval=1)
overbought       = input.float(80.0, "Overbought level", minval=1, maxval=99)
oversold         = input.float(20.0, "Oversold level", minval=1, maxval=99)
lookback         = input.int(50, "Lookback candles (first low/high)", minval=2)
maxSetupBars     = input.int(50, "Max setup candles", minval=1)
stopBufferTicks  = input.int(2, "Stop buffer (ticks)", minval=0)
targetR          = input.float(3.0, "Target R multiple")
riskPerTradeUsd  = input.float(100.0, "Risk per trade (USD)", minval=0.0, group="Position sizing")
pointValueUsd    = input.float(5.0, "Point value (USD/point) -- MES=5, MNQ=2", minval=0.01, group="Position sizing")
maxContracts     = input.int(5, "Max contracts (hard cap)", minval=1, group="Position sizing")

// ---- Core series ----
rsi        = ta.rsi(close, rsiLength)
is50Low    = low  <= ta.lowest(low, lookback)    // includes the current candle
is50High   = high >= ta.highest(high, lookback)
stopBuffer = stopBufferTicks * syminfo.mintick

// ---- Setup state ----
var string setupDir        = na     // "long" / "short"
var float  firstExt        = na     // first low (long) / first high (short)
var float  firstRsi        = na
var float  trigger         = na     // first candle's high (long) / low (short)
var float  secondExt       = na     // lowest divergent low / highest divergent high
var bool   secondConfirmed = false
var int    barsSince       = 0

longSignal  = false
shortSignal = false
triggered   = false
float sigEntry  = na
float sigStop   = na
float sigTarget = na

if not na(rsi)
    if not na(setupDir)
        barsSince += 1
        isLong = setupDir == "long"

        // Entry uses only state from earlier candles: the second low must
        // have already closed before a later candle can trigger.
        if secondConfirmed and (isLong ? close > trigger : close < trigger)
            triggered := true
            sigEntry  := close
            if isLong
                sigStop    := math.min(secondExt, low) - stopBuffer
                sigTarget  := close + (close - sigStop) * targetR
                longSignal := close > sigStop
            else
                sigStop     := math.max(secondExt, high) + stopBuffer
                sigTarget   := close - (sigStop - close) * targetR
                shortSignal := close < sigStop
            setupDir := na
        else
            replaced = false
            if isLong ? low < firstExt : high > firstExt
                ext = isLong ? low : high
                if isLong ? rsi > firstRsi : rsi < firstRsi
                    secondExt := na(secondExt) ? ext : isLong ? math.min(secondExt, ext) : math.max(secondExt, ext)
                else
                    // Deeper extreme without divergence -> new first low/high.
                    firstExt        := ext
                    firstRsi        := rsi
                    trigger         := isLong ? high : low
                    secondExt       := na
                    secondConfirmed := false
                    barsSince       := 0
                    replaced        := true
            if not replaced
                if not na(secondExt)
                    secondConfirmed := true
                if barsSince >= maxSetupBars
                    setupDir := na

    // No setup in progress (or it just expired): look for a fresh first low/high.
    if na(setupDir) and not triggered
        if is50Low and rsi < oversold
            setupDir        := "long"
            firstExt        := low
            firstRsi        := rsi
            trigger         := high
            secondExt       := na
            secondConfirmed := false
            barsSince       := 0
        else if is50High and rsi > overbought
            setupDir        := "short"
            firstExt        := high
            firstRsi        := rsi
            trigger         := low
            secondExt       := na
            secondConfirmed := false
            barsSince       := 0

// ---- Position sizing ----
riskPerContract = longSignal ? (sigEntry - sigStop) * pointValueUsd : shortSignal ? (sigStop - sigEntry) * pointValueUsd : na
qty = (not na(riskPerContract) and riskPerContract > 0) ? math.max(1, math.min(math.floor(riskPerTradeUsd / riskPerContract), maxContracts)) : 0

finalLongSignal  = longSignal  and qty > 0 and strategy.position_size == 0
finalShortSignal = shortSignal and qty > 0 and strategy.position_size == 0

// ---- Fire entries + TradersPost webhook alerts ----
if finalLongSignal
    strategy.entry("Long", strategy.long, qty=qty)
    strategy.exit("Long Exit", from_entry="Long", stop=sigStop, limit=sigTarget)
    longMsg = '{"ticker":"' + syminfo.ticker + '","action":"buy","orderType":"market"' +
         ',"quantity":' + str.tostring(qty) +
         ',"signalPrice":' + str.tostring(sigEntry) +
         ',"stopLoss":{"type":"stop","stopPrice":' + str.tostring(sigStop) + '}' +
         ',"takeProfit":{"limitPrice":' + str.tostring(sigTarget) + '}}'
    alert(longMsg, alert.freq_once_per_bar_close)

if finalShortSignal
    strategy.entry("Short", strategy.short, qty=qty)
    strategy.exit("Short Exit", from_entry="Short", stop=sigStop, limit=sigTarget)
    shortMsg = '{"ticker":"' + syminfo.ticker + '","action":"sell","orderType":"market"' +
         ',"quantity":' + str.tostring(qty) +
         ',"signalPrice":' + str.tostring(sigEntry) +
         ',"stopLoss":{"type":"stop","stopPrice":' + str.tostring(sigStop) + '}' +
         ',"takeProfit":{"limitPrice":' + str.tostring(sigTarget) + '}}'
    alert(shortMsg, alert.freq_once_per_bar_close)

// ---- Visuals ----
plot(not na(setupDir) ? trigger : na, "Entry trigger (first candle high/low)", color=color.new(color.gray, 20), style=plot.style_linebr, linewidth=2)
plot(not na(setupDir) ? secondExt : na, "Stop level (second low/high)", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=2)
plotshape(finalLongSignal,  title="Long",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small)
plotshape(finalShortSignal, title="Short", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small)

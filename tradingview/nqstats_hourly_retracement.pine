//@version=6
// NQStats Hourly Retracement (nqstats.com "Hour Stats", NY session 08:00-16:00 ET).
// Built for a 1-minute chart.
//
// Step 1: at the start of each NY-session hour, draw a horizontal line at the
// hour's open price from the start of the hour to the end of the hour.
// Step 2: at the same time, draw the previous hour's high and low as dotted
// lines, each running from the bar that made it to the end of that hour.
// Step 3: mark the first breach of the previous hour high/low with the
// 20-minute segment it happened in (S1 = 00-20, S2 = 20-40, S3 = 40-60).
// Step 4: mark every inversed FVG (iFVG) on the chart timeframe as it forms.
// A bearish FVG becomes a bullish iFVG when a bar closes above its top; a
// bullish FVG becomes a bearish iFVG when a bar closes below its bottom.
// Step 5: trade it. After the first breach of the hour, the first iFVG
// pointing back toward the hour open (bullish after a low breach, bearish
// after a high breach) is entered with a market order on that bar's close.
// Stop = sweep extreme (lowest low / highest high since the breach), target =
// hour open. One trade per hour by default (see "Max trades per hour"); an
// open trade is closed at the end of the hour.
//
// History: TradingView keeps at most 500 lines, 500 labels and 500 boxes per
// script and deletes the oldest beyond that. To keep the past visible, the
// hour open, breach markers and trade risk/reward zones are plots (no limit).
// Only the previous hour high/low lines, the text labels and the iFVG boxes are
// drawing objects, and those are budgeted to last as long as possible.

// Commission defaults to Tradeify's NQ rate ($5.76 round trip = $2.88 per side);
// change it in Properties for micros. Slippage is 1 tick on market/stop fills.
strategy("NQStats Hourly Retracement", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500,
     process_orders_on_close=true, default_qty_type=strategy.fixed, default_qty_value=1, initial_capital=50000,
     commission_type=strategy.commission.cash_per_contract, commission_value=2.88, slippage=1)

// ---- Inputs ----
tz          = input.string("America/New_York", "Timezone")
firstHour   = input.int(8, "First hour (ET)", minval=0, maxval=23)
lastHour    = input.int(15, "Last hour (ET)", minval=0, maxval=23)
openColor   = input.color(color.black, "Hour open line color")
openWidth   = input.int(1, "Hour open line width", minval=1, maxval=4)
prevColor   = input.color(color.black, "Previous hour high/low color")
prevWidth   = input.int(1, "Previous hour high/low width", minval=1, maxval=4)
showLabels  = input.bool(true, "Show line labels")
breachTicks = input.int(1, "Breach threshold (ticks)", minval=1)
requireInside = input.bool(true, "Only hours that open inside the previous hour's range")
hiBreachColor = input.color(color.red, "High breach marker color")
loBreachColor = input.color(color.green, "Low breach marker color")
minGapTicks   = input.int(1, "Min FVG size (ticks)", minval=1)
maxFvgAge     = input.int(0, "Drop FVGs older than (bars, 0 = never)", minval=0)
bullIfvgColor = input.color(color.orange, "Bullish iFVG color")
bearIfvgColor = input.color(color.purple, "Bearish iFVG color")
closeAtHourEnd = input.bool(true, "Close open trade at end of hour")
ifvgScope = input.string("Session hours only", "Draw iFVGs", options=["Session hours only", "All hours"],
     tooltip="Boxes are capped at 500 by TradingView. Session-only keeps about 3x more history visible.")
maxTradesPerHour = input.int(1, "Max trades per hour", minval=1)

HOUR_MS = 60 * 60 * 1000

textAbove(t, price, txt, col) =>
    label.new(t, price, txt, xloc=xloc.bar_time, style=label.style_label_down,
         color=color.new(color.white, 100), textcolor=col, size=size.small)

// ---- Hour tracking ----
h = hour(time, tz)
newHour = h != hour(time[1], tz)
inSession = h >= firstHour and h <= lastHour
hourStart = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), h, 0)

// Running high/low of the current hour and the bar times where they were made.
var float curHi = na
var float curLo = na
var int curHiT = na
var int curLoT = na
var float prevHi = na
var float prevLo = na

if newHour
    prevHi := curHi
    prevLo := curLo
    if inSession and not na(prevHi)
        line.new(curHiT, prevHi, hourStart, prevHi, xloc=xloc.bar_time, color=prevColor, width=prevWidth, style=line.style_dotted)
        line.new(curLoT, prevLo, hourStart, prevLo, xloc=xloc.bar_time, color=prevColor, width=prevWidth, style=line.style_dotted)
        if showLabels
            textAbove((curHiT + hourStart) / 2, prevHi, "previous hour high", prevColor)
            textAbove((curLoT + hourStart) / 2, prevLo, "previous hour low", prevColor)
    curHi := high
    curLo := low
    curHiT := time
    curLoT := time
else
    if high > curHi
        curHi := high
        curHiT := time
    if low < curLo
        curLo := low
        curLoT := time

// ---- Hour open line ----
var float hourOpen = na
if newHour
    hourOpen := open
// Hiding the segment into each hour's first bar stops consecutive hours from
// being joined by a vertical step.
plot(inSession ? hourOpen : na, "Hour open", color=newHour ? na : openColor, linewidth=openWidth, style=plot.style_linebr)

// The plot only reaches the latest bar, so one reusable line extends the
// current hour's open to the end of the hour.
var line liveOpen = na
if barstate.islast
    line.delete(liveOpen)
    if inSession
        liveOpen := line.new(time, hourOpen, hourStart + HOUR_MS, hourOpen, xloc=xloc.bar_time, color=openColor, width=openWidth)
if newHour and inSession and showLabels
    textAbove(hourStart + HOUR_MS / 2, open, "hour open price", openColor)

// ---- First breach of the previous hour high/low ----
// A breach is a trade at least breachTicks beyond the level. Only the first
// breach of the hour counts. Segment 1 = minutes 00-20, 2 = 20-40, 3 = 40-60.
var bool breached = false
var int breachDir = 0     // 1 = low breached (look long), -1 = high breached (look short)
var float sweepExt = na   // lowest low / highest high since the breach
if newHour
    breached := false
    breachDir := 0
    sweepExt := na

// Extend the sweep extreme on bars after the breach bar.
if breachDir == 1
    sweepExt := math.min(sweepExt, low)
else if breachDir == -1
    sweepExt := math.max(sweepExt, high)

openInside = hourOpen > prevLo and hourOpen < prevHi
eligible = inSession and not breached and (openInside or not requireInside)
breachDist = breachTicks * syminfo.mintick
hiBreach = eligible and high >= prevHi + breachDist
loBreach = eligible and low <= prevLo - breachDist

if hiBreach or loBreach
    breached := true
    // Both levels on one bar: direction unknown, so no trade this hour.
    breachDir := hiBreach and loBreach ? 0 : hiBreach ? -1 : 1
    sweepExt := hiBreach ? high : low

// Markers are plotshapes, so they never get deleted. If one bar takes out
// both levels the order is unknown, so both get marked.
seg = math.floor(minute(time, tz) / 20) + 1
plotshape(hiBreach and seg == 1, "High breach S1", shape.labeldown, location.abovebar, hiBreachColor, text="S1", textcolor=color.white, size=size.tiny)
plotshape(hiBreach and seg == 2, "High breach S2", shape.labeldown, location.abovebar, hiBreachColor, text="S2", textcolor=color.white, size=size.tiny)
plotshape(hiBreach and seg == 3, "High breach S3", shape.labeldown, location.abovebar, hiBreachColor, text="S3", textcolor=color.white, size=size.tiny)
plotshape(loBreach and seg == 1, "Low breach S1", shape.labelup, location.belowbar, loBreachColor, text="S1", textcolor=color.white, size=size.tiny)
plotshape(loBreach and seg == 2, "Low breach S2", shape.labelup, location.belowbar, loBreachColor, text="S2", textcolor=color.white, size=size.tiny)
plotshape(loBreach and seg == 3, "Low breach S3", shape.labelup, location.belowbar, loBreachColor, text="S3", textcolor=color.white, size=size.tiny)

// ---- Inversed FVGs ----
type FVG
    int startBar
    float top
    float bot
    bool bearish

MAX_TRACKED = 200
var fvgs = array.new<FVG>()

drawIfvg(FVG f, col) =>
    box.new(f.startBar, f.top, bar_index, f.bot, border_color=col, border_width=1,
         bgcolor=color.new(col, 60), text="iFVG", text_size=size.small, text_color=color.black)
    // Midline as a flat dashed box: lines are kept for the previous hour high/low.
    mid = (f.top + f.bot) / 2
    box.new(f.startBar, mid, bar_index, mid, border_color=color.black, border_style=line.style_dashed, bgcolor=na)

// Inversions of existing FVGs on this bar's close. Each FVG inverts at most once.
drawThisBar = ifvgScope == "All hours" or inSession
bullIfvg = false
bearIfvg = false
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        f = array.get(fvgs, i)
        if maxFvgAge > 0 and bar_index - f.startBar > maxFvgAge
            array.remove(fvgs, i)
        else if f.bearish and close > f.top
            if drawThisBar
                drawIfvg(f, bullIfvgColor)
            bullIfvg := true
            array.remove(fvgs, i)
        else if not f.bearish and close < f.bot
            if drawThisBar
                drawIfvg(f, bearIfvgColor)
            bearIfvg := true
            array.remove(fvgs, i)

// New 3-bar FVGs, anchored on the middle bar.
minGap = minGapTicks * syminfo.mintick
if bar_index >= 2
    if low[2] - high >= minGap
        array.push(fvgs, FVG.new(bar_index - 1, low[2], high, true))
    if low - high[2] >= minGap
        array.push(fvgs, FVG.new(bar_index - 1, low, high[2], false))
    while array.size(fvgs) > MAX_TRACKED
        array.shift(fvgs)

// ---- Trades ----
var int tradesThisHour = 0
if newHour
    tradesThisHour := 0

lastBarOfHour = time_close >= hourStart + HOUR_MS
canEnter = inSession and tradesThisHour < maxTradesPerHour and strategy.position_size == 0 and not (closeAtHourEnd and lastBarOfHour)
longSignal  = canEnter and breachDir == 1 and bullIfvg and close < hourOpen and close > sweepExt
shortSignal = canEnter and breachDir == -1 and bearIfvg and close > hourOpen and close < sweepExt

var float tEntry = na
var float tStop = na
var float tTarget = na

if longSignal or shortSignal
    tradesThisHour += 1
    stopPx = sweepExt
    if longSignal
        strategy.entry("Long", strategy.long)
        strategy.exit("Long exit", "Long", limit=hourOpen, stop=stopPx)
    else
        strategy.entry("Short", strategy.short)
        strategy.exit("Short exit", "Short", limit=hourOpen, stop=stopPx)
    tEntry := close
    tStop := stopPx
    tTarget := hourOpen

if closeAtHourEnd and lastBarOfHour and strategy.position_size != 0
    strategy.close_all(comment="Hour end")

// Risk/reward zones as plots so every past trade stays visible. They run from
// the entry bar to the exit bar.
inTrade = not na(tEntry)
pEntry  = plot(inTrade ? tEntry : na, "Trade entry", color=color.gray, style=plot.style_linebr)
pTarget = plot(inTrade ? tTarget : na, "Trade target", color=color.green, style=plot.style_linebr)
pStop   = plot(inTrade ? tStop : na, "Trade stop", color=color.red, style=plot.style_linebr)
fill(pEntry, pTarget, color.new(color.green, 70), "Reward zone")
fill(pEntry, pStop, color.new(color.red, 70), "Risk zone")

// Clear after plotting so the exit bar is still included.
justEntered = longSignal or shortSignal
hourEndExit = closeAtHourEnd and lastBarOfHour
if inTrade and not justEntered and (strategy.position_size == 0 or hourEndExit)
    tEntry := na
    tStop := na
    tTarget := na

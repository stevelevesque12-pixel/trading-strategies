# Copy to .env (never commit it) and fill in. See polyweather/README.md, "Pilot".
POLYWEATHER_LIVE=1
# Email login: export your key at polymarket.com (profile -> settings -> export private key).
POLY_PRIVATE_KEY=
# The account wallet address shown in your Polymarket profile menu.
POLY_WALLET=
# polymarket.com -> Settings -> API Keys -> Relayer API Keys (enables gasless merge/redeem).
POLY_RELAYER_API_KEY=
POLY_RELAYER_API_KEY_ADDRESS=

# Alerts (any combination). ntfy: install the ntfy app, subscribe to a long random topic.
ALERT_NTFY_TOPIC=
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

PILOT_CAPITAL_USD=400
PILOT_MAX_EVENT_USD=60
PILOT_MAX_SIDE_USD=15
PILOT_QUOTE_SHARES=20
PILOT_EDGE=0.01
PILOT_DAILY_LOSS_LIMIT_USD=40
# comma-separated city slugs; empty = every rewarded city
PILOT_CITIES=
